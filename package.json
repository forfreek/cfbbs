{
  "name": "cfbbs",
  "description": "A Cloudflare Workers-native federated BBS.",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.23",
    "@fedify/cfworkers": "^2.3.2",
    "@fedify/fedify": "^2.3.2",
    "@fedify/testing": "^2.3.2",
    "@fedify/vocab": "2.3.2",
    "@fontsource-variable/geist": "^5.2.9",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "isbot": "5.1.32",
    "lucide-react": "^1.25.0",
    "marked": "^18.0.6",
    "radix-ui": "^1.6.2",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-router": "7.9.6",
    "sanitize-html": "^2.17.6",
    "shadcn": "^4.13.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.15.3",
    "@cloudflare/vitest-pool-workers": "^0.18.6",
    "@cloudflare/workers-types": "^5.20260718.1",
    "@eslint/js": "^10.0.1",
    "@react-router/dev": "7.9.6",
    "@tailwindcss/vite": "4.1.17",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.1",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "playwright": "^1.61.1",
    "prettier": "^3.9.5",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "4.1.17",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.0.0",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "^4.1.10",
    "wrangler": "4.88.0"
  },
  "private": true,
  "scripts": {
    "build": "react-router build",
    "cf-typegen": "wrangler types && react-router typegen",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build && wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "dev": "react-router dev",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply cfbbs-local --local",
    "db:seed": "wrangler d1 execute cfbbs-local --local --file=app/db/seed.sql",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "pnpm build && vite preview",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "pnpm run cf-typegen && tsc -b"
  },
  "type": "module",
  "packageManager": "pnpm@11.15.0",
  "engines": {
    "node": "22.23.1"
  }
}
