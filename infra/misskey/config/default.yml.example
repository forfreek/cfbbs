# Copy this file to config/default.yml and replace every CHANGE_ME value.
# The public URL must use the actual, HTTPS-enabled Misskey test hostname.
url: https://misskey-test.s.lukelzlz.top/

db:
  host: db
  port: 5432
  db: misskey
  user: misskey
  pass: CHANGE_ME_POSTGRES_PASSWORD

redis:
  host: redis
  port: 6379

# Generate once when creating the disposable test instance. Keep it stable for
# that instance's lifetime, and never reuse it for production.
id: CHANGE_ME_INSTANCE_ID
