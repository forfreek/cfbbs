{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cfbbs",
  "main": "./workers/app.ts",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cfbbs-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "FEDIFY_KV",
      "id": "00000000000000000000000000000000"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "FEDERATION_QUEUE",
        "queue": "cfbbs-local-federation"
      }
    ],
    "consumers": [
      {
        "queue": "cfbbs-local-federation",
        "max_retries": 5,
        "dead_letter_queue": "cfbbs-local-federation-dlq"
      }
    ]
  },
  "triggers": {
    "crons": [
      "*/5 * * * *",
      "0 3 * * *"
    ]
  },
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "APP_ORIGIN": "http://127.0.0.1:5173",
    "VALUE_FROM_CLOUDFLARE": "Hello from Cloudflare"
  },
  "env": {
    "test": {
      "name": "cfbbs-test",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "cfbbs-test-db",
          "database_id": "ebaf629b-f78c-4a28-bdbf-3192214c4a86",
          "migrations_dir": "drizzle"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "FEDIFY_KV",
          "id": "ce61356028874cbaa7735c49e75ace04"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "FEDERATION_QUEUE",
            "queue": "cfbbs-test-federation"
          }
        ],
        "consumers": [
          {
            "queue": "cfbbs-test-federation",
            "max_retries": 5,
            "dead_letter_queue": "cfbbs-test-federation-dlq"
          }
        ]
      },
      "triggers": {
        "crons": [
          "*/5 * * * *",
          "0 3 * * *"
        ]
      },
      "routes": [
        {
          "pattern": "cfbbs-test.s.lukelzlz.top",
          "custom_domain": true
        }
      ],
      "vars": {
        "APP_ORIGIN": "https://cfbbs-test.s.lukelzlz.top",
        "FEDIFY_ALLOW_PRIVATE_ADDRESS": "true",
        "VALUE_FROM_CLOUDFLARE": "Hello from the CFBBS test environment"
      },
      "r2_buckets": [
        {
          "binding": "MEDIA_BUCKET",
          "bucket_name": "cfbbs-test-media"
        }
      ]
    }
  },
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "cfbbs-local-media",
      "preview_bucket_name": "cfbbs-local-media"
    }
  ]
}
