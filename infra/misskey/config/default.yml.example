# Copy this file to config/default.yml and replace every CHANGE_ME value.
# The public URL must use the actual, HTTPS-enabled Misskey test hostname.
url: https://misskey-test.s.lukelzlz.top/
# Misskey 2026.x no longer defaults this value. Docker publishes this internal
# port to the isolated host port configured in .env.
port: 3000

db:
  host: db
  port: 5432
  db: misskey
  user: misskey
  pass: CHANGE_ME_POSTGRES_PASSWORD

redis:
  host: redis
  port: 6379

# Misskey's persistent record-ID generation algorithm. Do not change it after
# the instance has started; "aidx" is the upstream default.
id: "aidx"
